# ============================================================
#  Stay Management - Environment Configuration (SAMPLE)
#  Copy to .env and fill real values. NEVER commit .env.
# ============================================================
# deployment, production, testing.
CI_ENVIRONMENT=deployment
# Enable only for isolated local testing; keep disabled in shared environments.
DEV_EXPOSE_OTP=false

# Prefer the IPv4 loopback on Windows/XAMPP to avoid localhost IPv6 delays.
DB_HOSTNAME=127.0.0.1
DB_PORT=3306
DB_DATABASE=stay_management
DB_USERNAME=root
DB_PASSWORD=
DB_DBDRIVER=mysqli

ENCRYPTION_KEY=

SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER_ID=
