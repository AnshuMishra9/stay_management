.DS_Store

application/cache/*
!application/cache/index.html

application/logs/*
!application/logs/index.html

!application/*/.htaccess

# User-uploaded files — customer Aadhar/PAN docs & room images (PII).
# Never commit these; keep only the folder skeleton + deny-all .htaccess.
/secure_uploads/customers/*
/secure_uploads/rooms/*
!/secure_uploads/customers/index.html
!/secure_uploads/rooms/index.html

composer.lock
tests/mocks/database/ci_test.sqlite

user_guide_src/build/*
user_guide_src/cilexer/build/*
user_guide_src/cilexer/dist/*
user_guide_src/cilexer/pycilexer.egg-info/*
/vendor/

# IDE Files
#-------------------------
/nbproject/
.idea/*

## Sublime Text cache files
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project
/tests/tests/
/tests/results/

# Environment secrets
.env

# Historical populated backups and deployment-specific mappings remain in the
# external private archive. The canonical zero-data db/stay_management.sql is
# intentionally tracked and is therefore not ignored here.
/db/dream_project.sql
/db/plants_migration/backup_before_migration.sql
/db/add_admin_multitenancy.sql
/db/MULTITENANCY.md
/db/drop_database.sql

# Browser-debug response capture; maintained tests must assert in memory.
/tests/debug_booking_response.html
